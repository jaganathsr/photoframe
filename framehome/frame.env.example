# Copy to frame.env (git-ignored) and fill in. Used by build.sh.

# Your frame's IP address on your home network (shown on the frame's home screen).
FRAME_IP=192.168.1.50
# PIN for the phone remote (shown on the frame's home screen). Needed for `./build.sh remote`.
FRAME_PIN=

# Immich server and a read-only API key (Immich: Account Settings -> API Keys).
IMMICH_URL=http://192.168.1.10:2283
IMMICH_API_KEY=
# Album to show at first; you can change it later from the phone remote.
IMMICH_ALBUM_ID=

# Signing key password (optional; default "framehome"). Keep keystore.jks private and backed up.
# KEYSTORE_PASSWORD=
